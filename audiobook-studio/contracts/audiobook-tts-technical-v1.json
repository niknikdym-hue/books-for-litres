{
  "schema_version": 1,
  "revision": 1,
  "updated_at": "2026-09-01T00:00:00+00:00",
  "entries": [
    {
      "rule_id": "AUDIO-TTS-URL-001",
      "value": "\\bhttps?://[^\\s<>()]+",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Неожиданный URL не должен озвучиваться как часть литературного текста.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-URL-002",
      "value": "\\bwww\\.[^\\s<>()]+",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Web-адрес без протокола требует человеческой проверки до синтеза.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-MARKDOWN-001",
      "value": "!?\\[[^\\]\\n]{1,200}\\]\\([^\\)\\n]{1,500}\\)",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Markdown link/image residue не является TTS-ready литературным текстом.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-MARKDOWN-002",
      "value": "(?m)^\\s{0,3}#{1,6}\\s+\\S",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Markdown heading marker должен быть удалён осознанно до TTS.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-MARKDOWN-003",
      "value": "(?m)^\\s*(?:```|~~~)",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Fenced-code marker не должен попадать в синтез речи.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-MARKDOWN-004",
      "value": "(?:\\*\\*[^*\\n]{1,200}\\*\\*|__[^_\\n]{1,200}__|`[^`\\n]{1,200}`)",
      "match_type": "REGEX",
      "action": "WARN",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Inline Markdown/код может быть артефактом верстки; требуется человеческая проверка.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-HTML-001",
      "value": "</?(?:html|body|p|div|span|br|speak|phoneme|break|prosody|say-as|sub)\\b[^>]*>",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "HTML/SSML/pronunciation markup не поддерживается как литературный TTS-ready текст в этом контуре.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-HTML-002",
      "value": "&(?:nbsp|lt|gt|amp|quot|#\\d+|#x[0-9a-f]+);",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "HTML entity residue должен быть осознанно преобразован до синтеза.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-PROMPT-001",
      "value": "(?mi)^\\s*(?:system|assistant|user|developer|prompt)\\s*:\\s*",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Prompt/service role residue не должен озвучиваться.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-PLACEHOLDER-001",
      "value": "\\b(?:TODO|FIXME|TBD|PLACEHOLDER)\\b",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Служебный placeholder/TODO означает незавершённый TTS-ready текст.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-TEMPLATE-001",
      "value": "(?:\\{\\{[^{}\\n]{1,200}\\}\\}|\\[\\[[^\\[\\]\\n]{1,200}\\]\\]|<<<?[^>\\n]{1,200}>>?>)",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Шаблонный/управляющий маркер должен быть разрешён до синтеза.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-PATH-001",
      "value": "(?:/Users/|/home/|[A-Za-z]:\\\\(?:Users|Windows|Program Files)\\\\)",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Локальный файловый путь является техническим residue и не должен попадать в речь.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-ID-001",
      "value": "\\b[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\b",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "UUID обычно является техническим идентификатором, а не литературным текстом.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-ID-002",
      "value": "\\b[0-9a-f]{40}(?:[0-9a-f]{24})?\\b",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Длинный hex/SHA идентификатор требует удаления или осознанной литературной обработки до TTS.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-ID-003",
      "value": "\\b[A-Za-z][A-Za-z0-9]{2,}_[A-Za-z0-9_]{3,}\\b",
      "match_type": "REGEX",
      "action": "WARN",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Snake-case token похож на технический идентификатор; проверить перед синтезом.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-CONTROL-001",
      "value": "[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]",
      "match_type": "REGEX",
      "action": "BLOCK",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Управляющий символ является техническим артефактом и не должен попадать в TTS.",
      "created_at": null,
      "updated_at": null
    },
    {
      "rule_id": "AUDIO-TTS-LAYOUT-001",
      "value": "(?mi)^\\s*(?:page|страница|стр\\.)\\s+\\d+\\s*$",
      "match_type": "REGEX",
      "action": "WARN",
      "profiles": ["AUDIOBOOK_TTS_TECHNICAL"],
      "origin": "SYSTEM",
      "rationale": "Маркер печатной страницы может быть артефактом верстки; проверить перед озвучкой.",
      "created_at": null,
      "updated_at": null
    }
  ]
}
