{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiobook-studio.local/contracts/pronunciation-dictionary-v1.schema.json",
  "title": "Audiobook Studio User Pronunciation Dictionary V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vowel_number", "display"],
      "properties": {
        "vowel_number": {"type": "integer", "minimum": 1},
        "display": {"type": "string", "minLength": 1},
        "first_seen_at": {"type": ["string", "null"]},
        "last_seen_at": {"type": ["string", "null"]}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "normalized_word",
        "word",
        "mode",
        "preferred",
        "variants",
        "actor",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^PRON-GLOBAL-[A-Z0-9]{12,32}$"
        },
        "normalized_word": {"type": "string", "minLength": 1},
        "word": {"type": "string", "minLength": 1},
        "mode": {
          "type": "string",
          "enum": ["AUTO", "REVIEW_REQUIRED", "DISABLED"]
        },
        "preferred": {
          "anyOf": [
            {"$ref": "#/$defs/variant"},
            {"type": "null"}
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/variant"}
        },
        "actor": {"const": "OWNER"},
        "source": {
          "type": "string",
          "enum": [
            "STUDIO_CORRECTION",
            "MIGRATED_BOOK_RULE",
            "DICTIONARY_EDIT"
          ]
        },
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
